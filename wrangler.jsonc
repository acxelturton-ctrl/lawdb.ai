{
  // LawDB.ai: static site + Worker API + D1 database.
  // The Worker name here must match the Cloudflare project name exactly.
  "name": "lawdb-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Static files are served directly (free, fast). The Worker only runs for the API, the three data
    // files, and the pages that embed the firm list (find-lawyers, the state/city hubs): for those it
    // swaps in the live database list, falling back to the static file if the database is unavailable.
    "run_worker_first": [
      "/api/*",
      "/firms_data.json", "/blog_data.json", "/firms_hours.json",
      "/find-lawyers",
      "/", "/for-firms",
      "/firms/*",
      "/report-listing",
      "/news", "/news/*", "/sitemap-news.xml", "/sitemap-firms.xml", "/sitemap-lawyers.xml", "/lawyers/*", "/*.html",
      "/img/*",
      "/*/", "/*/*/"
    ]
  },
  // The site lives at lawdb.ai (a custom domain added in the Cloudflare dashboard). The free *.workers.dev address and the per-version preview
  // addresses are OFF so there is one public address and no duplicate copy of the site for search engines to find.
  "workers_dev": false,
  "preview_urls": false,
  // Keep anything added by hand in the dashboard (e.g. a "Text" variable) when this config is deployed.
  "keep_vars": true,
  // Non-secret settings. Secrets (BREVO_API_KEY, ADMIN_EMAILS) are set in the Cloudflare dashboard:
  // Workers & Pages -> lawdb -> Settings -> Variables and Secrets.
  "vars": {
    "SITE_ORIGIN": "https://lawdb.ai",
    "MAIL_FROM_EMAIL": "info@lawdb.ai",
    "MAIL_FROM_NAME": "LawDB",
    // The Featured plan payment link (set when the US Stripe product exists).
    "STRIPE_PAYMENT_LINK": ""
  },
  // Nightly at 07:17 UTC: housekeeping (retention rules) and a backup of every table into the KV store below.
  "triggers": { "crons": ["17 7 * * *", "37 7 * * *", "*/5 * * * *", "7 * * * *", "* * * * *"] },
  "kv_namespaces": [
    { "binding": "BACKUPS", "id": "12ab185cedc943f7a7ab919710ef58db" }
  ],
  // Firm pictures (private bucket; served to the public only through /img/<id>).
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "lawdb-ai-images" }
  ],
  // LawDB AI on the home page: Cloudflare Workers AI (no key needed). It only reads the visitor's situation; see src/lib/ai-match.js.
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lawdb-ai",
      "database_id": "63fd6523-e1f4-46ea-b4d5-1ea8a59fdc47"
    }
  ]
}
